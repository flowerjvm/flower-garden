{
  "name": "flower-garden",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "play": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/play-flower-garden.ps1",
    "play:smoke": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/play-flower-garden.ps1 -NoBrowser -ExitAfterReady",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/first-bloom-builder-game.test.mjs tests/verdant-learning-game.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "fixtures:verdant": "node scripts/materialize-verdant-fixtures.mjs",
    "fixtures:verdant:check": "node scripts/materialize-verdant-fixtures.mjs --check"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.53",
    "vite": "^8.1.5",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
