{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowerjvm.dev/flower-garden/contracts/world-manifest.schema.json",
  "title": "Flower Garden World Manifest",
  "description": "The minimal descriptor for one compile-time world catalog entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "displayName",
    "catalogOrder",
    "status",
    "runtimeModuleId",
    "projectionModuleId",
    "missions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "trace-event.schema.json#/$defs/slug"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "catalogOrder": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "EXPERIMENTAL",
        "AVAILABLE",
        "PLANNED"
      ]
    },
    "runtimeModuleId": {
      "oneOf": [
        {
          "$ref": "trace-event.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectionModuleId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mission"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "AVAILABLE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "runtimeModuleId": {
            "$ref": "trace-event.schema.json#/$defs/id"
          },
          "projectionModuleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  ],
  "$defs": {
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "status",
        "learningObjectives",
        "allowedCommands"
      ],
      "properties": {
        "id": {
          "$ref": "trace-event.schema.json#/$defs/slug"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "PLANNED",
            "HIDDEN"
          ]
        },
        "learningObjectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "allowedCommands": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "const": "TICK"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "AVAILABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "allowedCommands": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "allowedCommands": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
